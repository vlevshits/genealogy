# =============================================================================
# Family Tree Platform — Environment Variables
# Copy this file to .env and adjust your configuration:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Web & Server
# -----------------------------------------------------------------------------
PORT=8080
APP_ENV=production
RUST_LOG=info,genealogy=debug
TREE_TITLE="Levshits Family Archive"
DEFAULT_LOCALE=ru

# -----------------------------------------------------------------------------
# 2. Public URLs & WebAuthn / Passkeys (Required)
# -----------------------------------------------------------------------------
# Fully qualified URL where the web app is accessible:
APP_ORIGIN=https://tree.example.com

# WebAuthn Relying Party ID (domain name without protocol or port):
RP_ID=tree.example.com

# Display name presented in Touch ID / Windows Hello prompts:
RP_NAME="Levshits Family Archive"

# -----------------------------------------------------------------------------
# 3. Database & Caching
# -----------------------------------------------------------------------------
POSTGRES_USER=genealogy
POSTGRES_PASSWORD=replace_with_a_secure_random_password_123!
POSTGRES_DB=genealogy

# -----------------------------------------------------------------------------
# 4. Privacy & Public Access
# -----------------------------------------------------------------------------
# If true, anonymous visitors can browse the tree with living persons masked:
ENABLE_PUBLIC_ACCESS=true

# Allow open registration (false = invite-only):
ENABLE_REGISTRATION=false

# Years before present to assume a person is living if no death date exists:
LIVING_PERSON_AGE_THRESHOLD=110

# -----------------------------------------------------------------------------
# 5. Media & Storage
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=100
THUMBNAIL_QUALITY=85

# -----------------------------------------------------------------------------
# 6. Transactional Email (SMTP) — for Magic Links & Invites
# -----------------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@example.com
SMTP_PASSWORD=your_smtp_secret_password
SMTP_FROM_EMAIL=tree@example.com
SMTP_FROM_NAME="Levshits Family Tree"

# -----------------------------------------------------------------------------
# 7. Automated Backups
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_CRON="0 3 * * *"
BACKUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# 8. Authentication & Sessions (see docs/features/17-api-security-operations.md)
# -----------------------------------------------------------------------------
# Password fallback: auto (enabled when no HTTPS or no SMTP) | true | false
AUTH_PASSWORD_ENABLED=auto
SESSION_TTL_DAYS=30

# -----------------------------------------------------------------------------
# 9. Maps & Geocoding (see docs/features/12-places.md)
# -----------------------------------------------------------------------------
# Leave MAP_TILE_URL empty to disable maps entirely (no external requests):
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION="© OpenStreetMap contributors"
GEOCODING_ENABLED=false
GEOCODING_URL=https://nominatim.openstreetmap.org

# -----------------------------------------------------------------------------
# 10. History, Jobs & Misc
# -----------------------------------------------------------------------------
HISTORY_RETENTION_DAYS=365
JOB_WORKERS=2
MAX_IMPORT_SIZE_MB=2048
BACKUP_INCLUDE_GEDCOM=false
SETTINGS_LOCKED_FROM_ENV=false
PUBLIC_SEARCH_SHOW_LIVING=false
