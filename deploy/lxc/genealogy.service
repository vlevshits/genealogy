[Unit]
Description=Genealogy Family Tree Server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=genealogy
Group=genealogy
WorkingDirectory=/var/lib/genealogy
EnvironmentFile=/etc/genealogy/genealogy.env
ExecStart=/opt/genealogy/genealogy-backend
Restart=always
RestartSec=5s

# Security hardening for Debian / Ubuntu LXC
# Grant permission to bind directly to privileged port 80/443 without root
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/genealogy
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
