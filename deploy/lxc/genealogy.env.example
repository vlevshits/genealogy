# ==============================================================================
# Genealogy Family Tree — Production LXC Environment Configuration
# Location: /etc/genealogy/genealogy.env (chmod 600, owned by genealogy:genealogy)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Web & Server
# Listens directly without proxy (port 80 for standard HTTP or 443 with TLS reverse proxy)
# ------------------------------------------------------------------------------
PORT=80
APP_ENV=production
RUST_LOG=info,genealogy=debug

# ------------------------------------------------------------------------------
# 2. Domain & Passkeys (WebAuthn / FIDO2)
# APP_ORIGIN: Fully qualified public URL accessed in the browser.
# RP_ID: Hostname without protocol/port (e.g. tree.home.lan or 192.168.1.50).
# ------------------------------------------------------------------------------
APP_ORIGIN=http://localhost
RP_ID=localhost
RP_NAME=Family Tree Archive

# ------------------------------------------------------------------------------
# 3. Database Connection
# When using local PostgreSQL on the LXC container:
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://genealogy:CHANGE_ME_PASSWORD@127.0.0.1:5432/genealogy?sslmode=disable
DATABASE_REQUIRED=true

# ------------------------------------------------------------------------------
# 4. Storage & Static Assets
# ------------------------------------------------------------------------------
MEDIA_STORAGE_PATH=/var/lib/genealogy/media
BACKUP_PATH=/var/lib/genealogy/backups
FRONTEND_STATIC_PATH=/var/www/genealogy
MAX_UPLOAD_SIZE_MB=100
THUMBNAIL_QUALITY=85

# ------------------------------------------------------------------------------
# 5. Privacy, Tree Identity & Locale
# ------------------------------------------------------------------------------
TREE_TITLE=Family Tree Archive
DEFAULT_LOCALE=ru
ENABLE_PUBLIC_ACCESS=false
ENABLE_REGISTRATION=false
LIVING_PERSON_AGE_THRESHOLD=110

# ------------------------------------------------------------------------------
# 6. Authentication & Sessions
# AUTH_PASSWORD_ENABLED: auto (enabled if HTTP or SMTP disabled), true, or false
# ------------------------------------------------------------------------------
AUTH_PASSWORD_ENABLED=auto
SESSION_TTL_DAYS=30
MAX_IMPORT_SIZE_MB=2048
JOB_WORKERS=2

# ------------------------------------------------------------------------------
# 7. Automated Nightly Backups
# ------------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_INCLUDE_GEDCOM=false

# ------------------------------------------------------------------------------
# 8. Transactional Email (SMTP) — Optional for Magic Links
# ------------------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=tree@example.com
SMTP_FROM_NAME=Family Tree

# ------------------------------------------------------------------------------
# 9. AI & Multimodal Story Intake (Optional — Google Gemini 3.8 Flash)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
