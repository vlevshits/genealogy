# =============================================================================
# Git Ignore Configuration
# =============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Settings
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Environment & Secrets (NEVER commit actual secret keys or .env)
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Node.js / Frontend
node_modules/
dist/
dist-ssr/
build/
*.tsbuildinfo
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache

# Rust / Backend
/backend/target/
target/
**/*.rs.bk
*.pdb
Cargo.lock.temp

# Docker & Volume Local Mounts
postgres-data/
media-data/
backup-data/
data/

# Temporary / Scratch Files
tmp/
temp/
*.log
scratch/
